# ---------------------------------------------------------------
# Offert Pro — environment variables
# Copy to .env.local (dev) or configure in your hosting provider (prod)
# ---------------------------------------------------------------

# Public site URL (canonical URLs, sitemap, OG images, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://offertpro.se

# ---------------------------------------------------------------
# Database (REQUIRED in production)
# ---------------------------------------------------------------
# Use any Postgres provider: Neon, Supabase, Railway, Vercel Postgres, etc.
# Example: postgres://user:password@host:5432/dbname?sslmode=require
# Without DATABASE_URL in production the app runs in memory-only mode
# and data is lost on every deploy/cold start.
DATABASE_URL=

# Alias supported by Vercel Postgres integration
# POSTGRES_URL=

# ---------------------------------------------------------------
# SMTP (for sending quotes/invoices via email)
# ---------------------------------------------------------------
# Leave empty to fall back to console logging (dev only).
# In production all three of HOST/USER/PASS must be set for email to work.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional "From" header; defaults to SMTP_USER
SMTP_FROM=

# ---------------------------------------------------------------
# Dev / demo options (do NOT enable in production)
# ---------------------------------------------------------------
# Set to "true" to seed demo customers/quotes/invoices into the DB
# on first boot. Leave unset in production — first signup becomes
# the admin account and the store starts empty.
# SEED_DEMO_DATA=
